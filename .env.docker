# Configuration pour environnement Docker
IS_LOCAL=false

# Database URL pour containers Docker (utilise le nom du service postgres)
DATABASE_URL=postgresql://user:password@postgres:5432/thebradery_db

# PostgreSQL GCP Configuration (pour basculer vers GCP si besoin)
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=10.2.0.3
PG_PORT=5432
PG_DATABASE=thebradery_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://localhost:8501,http://localhost:3000

# Ollama Configuration (accès depuis container)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct-v0.3-q4_1

# Security
SESSIONMIDDLESECRET=thebradery_docker_secret_change_in_production